rules_version = '2';

// ---------------------------------------------------------------
// Regras de acesso — Produção & Perdas, Padaria Pão de Mel (ago/2026)
//
// Este arquivo é a única coisa que protege os dados. A configuração do
// Firebase (src/lib/firebase.ts) é pública por desenho e não protege
// nada — quem decide o que cada loja pode ler e escrever é aqui.
//
// Modelo da operação: as filiais NÃO produzem, elas PEDEM. A matriz monta
// o cronograma, mantém o catálogo e produz para todos. Por isso:
//
//   produtos  -> todos leem (a filial precisa dos nomes para pedir),
//                só a matriz escreve
//   planos    -> todos leem (a filial vê o que foi produzido),
//                só a matriz escreve
//   perdas    -> todos leem (a matriz precisa da visão consolidada),
//                cada loja só escreve perda carimbada com o próprio id
//
// Como aplicar: console do Firebase -> Firestore -> aba Regras -> colar
// este conteúdo -> Publicar.
// ---------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // Sem conta autenticada, nada acontece. Vale para todas as regras
    // abaixo — nenhuma delas concede acesso a visitante anônimo.
    function autenticado() {
      return request.auth != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    // Mapeamento conta -> loja. Precisa espelhar src/lib/lojas.ts: se um
    // dia entrar uma quarta loja, os dois arquivos mudam juntos.
    function lojaDoUsuario() {
      return email() == 'matriz@paodemel.local' ? 'MATRIZ'
           : email() == 'arthur@paodemel.local' ? 'FILIAL_ARTHUR_BERNARDES'
           : email() == 'benjamin@paodemel.local' ? 'FILIAL_BENJAMIN_CONSTANT'
           : 'DESCONHECIDA';
    }

    // Conta autenticada que não é nenhuma das três não recebe nada —
    // criar um usuário no console por engano não vira acesso ao banco.
    function lojaConhecida() {
      return autenticado() && lojaDoUsuario() != 'DESCONHECIDA';
    }

    function ehMatriz() {
      return lojaConhecida() && lojaDoUsuario() == 'MATRIZ';
    }

    // Catálogo compartilhado: a filial precisa ler para montar o pedido,
    // mas quem cadastra, corrige e exclui produto é a matriz.
    match /produtos/{codigoPdv} {
      allow read: if lojaConhecida();
      allow write: if ehMatriz();
    }

    // Cronograma de produção — só a matriz produz.
    match /planos/{planoId} {
      allow read: if lojaConhecida();
      allow write: if ehMatriz();
    }

    // Perdas: cada loja lança as próprias. A verificação é sobre o
    // conteúdo do documento, não sobre o id — assim uma filial não
    // consegue gravar uma perda dizendo que aconteceu em outra loja.
    match /perdas/{perdaId} {
      allow read: if lojaConhecida();
      allow create: if lojaConhecida()
                    && request.resource.data.lojaId == lojaDoUsuario();
      // Perda lançada não se reescreve nem se apaga: é registro contábil
      // de desperdício. Correção se faz com um lançamento novo.
      allow update, delete: if false;
    }

    // Qualquer coleção não listada acima fica fechada. Deixar o padrão
    // fechado é o que impede uma coleção nova nascer aberta por
    // esquecimento — a regra dela tem que ser escrita de propósito.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
